@inherits LayoutComponentBase
@inject NavigationManager NavigationManager

<div class="top-row px-4">
    <div>
        <NavLink href="" Match="NavLinkMatch.All">
            <img class="profile-logo" src="Pictures/my-photo.jpg" />
        </NavLink>
    </div>
    <div>
        <NavLink class="nav-link" href="KnowledgeBase" Match="NavLinkMatch.All">
            <span aria-hidden="true">База знаний</span>
        </NavLink> 
    </div>
</div>
<main>
    <div class="content">
          @Body
    </div>
</main>
<footer>
    <span id="footer-text">2026 
        <br />Контакты: <a href="@Telegram"><img class="contact-logo" src="Pictures/Telegram_logo.webp"/></a>
        <a href="mailto:@Email">
            <img class="contact-logo" src="Pictures/gmail.png"/>
        </a>
        </span>
</footer>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>


@code{
    private string Telegram = "https://t.me/JnCoffey";
    private string Email = "my.master.use@gmail.com";
}
